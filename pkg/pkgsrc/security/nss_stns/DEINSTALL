# $NetBSD$
#
# Take away the /usr/lib symlink that INSTALL created.  See the comment there
# for why ${STAGE} is tested rather than $2.

STNS_MODULE="nss_stns.so.@NSS_VERSION@"

case ${STAGE} in
DEINSTALL)
	if ${TEST} -h "/usr/lib/${STNS_MODULE}"; then
		${RM} -f "/usr/lib/${STNS_MODULE}"
	fi
	;;
esac
